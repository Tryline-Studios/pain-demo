# Copy to `backend/.env` to override; every setting is optional and shown at its default (spec section 16).

# Log renderer, `json` or `console`. Default: `console` when stdout is a TTY, else `json`.
# PAIN_DEMO_LOG_FORMAT=console

# `DEBUG` adds the corpus.build scenario and build report per request.
# PAIN_DEMO_LOG_LEVEL=INFO

# The commit reported in the Generator Version. Default: the checkout's `HEAD`, else `unknown`.
# PAIN_DEMO_GIT_SHA=
