# Copy to backend/.env for the native dev loop. Every setting is optional; there are no secrets (spec section 16).

# Log renderer: console (coloured lines) or json. Defaults to console on a TTY, json otherwise.
#PAIN_DEMO_LOG_FORMAT=console

# CRITICAL, ERROR, WARNING, INFO or DEBUG. DEBUG adds the corpus.build scenario and build report per request.
#PAIN_DEMO_LOG_LEVEL=INFO

# The commit the app was built from, reported by GET /api/v1/version. The image build sets it; a native run
# reads it from the git checkout instead.
#PAIN_DEMO_GIT_SHA=
